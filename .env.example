# File: .env.example
# Root .env used by Docker Compose. Copy to .env and fill in values.
# NEVER commit .env to version control.

# ── Backend ──────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# OpenAI — get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

ALLOWED_ORIGINS=http://localhost:5173

# ── Transcription ────────────────────────────────────────────────────
ASSEMBLYAI_API_KEY=    # https://www.assemblyai.com/app — for audio transcription

# ── Notifications ────────────────────────────────────────────────────
SENDGRID_API_KEY=      # https://sendgrid.com — email notifications

# ── Slack Integration ────────────────────────────────────────────────
SLACK_BOT_TOKEN=       # Slack app bot token — post summaries
SLACK_CHANNEL_ID=      # Target Slack channel ID

# ── Background Jobs ──────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# ── Video Platform Webhooks ──────────────────────────────────────────
ZOOM_WEBHOOK_SECRET_TOKEN=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
AZURE_CLIENT_ID=       # Microsoft Graph API (Teams)
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
GOOGLE_CLIENT_ID=      # Google Meet API
GOOGLE_CLIENT_SECRET=
WEBEX_CLIENT_ID=       # Cisco Webex API
WEBEX_CLIENT_SECRET=

# ── Object Storage ───────────────────────────────────────────────────
STORAGE_BUCKET=media   # Supabase Storage bucket name

# ── Frontend (Vite build args + dev server) ──────────────────────────
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_API_URL=https://prism-meeting-intelligence-production.up.railway.app
# For local dev: VITE_API_URL=http://localhost:8000