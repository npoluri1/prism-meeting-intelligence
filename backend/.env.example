# File: backend/.env.example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Get from: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
# Used for: AI extraction (gpt-4o-mini) + Whisper transcription fallback
OPENAI_API_KEY=sk-proj-...

# ── AssemblyAI (primary transcription) ───────────────────────────────────────
# Get from: https://www.assemblyai.com/dashboard (free tier available)
# Used for: Audio/video transcription with speaker diarization
ASSEMBLYAI_API_KEY=

# ── SendGrid (email notifications) ───────────────────────────────────────────
# Get from: https://app.sendgrid.com/settings/api_keys (free tier: 100 emails/day)
# Used for: "Meeting notes ready" email when upload processing completes
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@getprism.ai

# ── Slack (optional outbound integration) ────────────────────────────────────
# Get from: https://api.slack.com/apps → Create App → Bot Token
# Used for: Posting meeting summaries to a Slack channel
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0123456789

# ── Storage ───────────────────────────────────────────────────────────────────
# Supabase Storage bucket name for audio/video files
# Create bucket at: Supabase Dashboard → Storage → New bucket (public)
STORAGE_BUCKET=meeting-media

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173

# ── Frontend URL (used in email links) ───────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Phase 2: Zoom integration ────────────────────────────────────────────────
# Get from: https://marketplace.zoom.us (Server-to-Server OAuth app)
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

# ── Phase 2: Microsoft Teams integration ─────────────────────────────────────
# Get from: https://portal.azure.com → App registrations
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
TEAMS_WEBHOOK_VALIDATION_TOKEN=

# ── Port (used by Railway) ────────────────────────────────────────────────────
PORT=8000
